// ============================================================
// info Marhaen — Skema Database (Fase 0 · Fondasi)
// Sumber kebenaran: blueprint.md Bagian 7.
//
// CATATAN FASERING:
//  - Fase 0/1 : User, Role, Permission, Artikel, Kategori, Tag,
//               HalamanStatis, AuditLog (+ enums alur editorial).
//  - Fase 2+  : Komentar, PesanLangsung, Leaderboard, Pencapaian,
//               LangganNewsletter, SlotIklanDonasi (ditambah via migrasi).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUM
// ============================================================

/// Alur editorial (blueprint 6.1): state machine artikel.
enum StatusArtikel {
  DRAFT /// Draft oleh penulis
  DIAJUKAN /// Submitted — masuk antrian redaksi
  SEDANG_DITINJAU /// Sedang ditinjau editor
  DIMINTA_REVISI /// Dikembalikan ke penulis untuk revisi
  DISETUJUI /// Disetujui, menunggu terbit/jadwal
  TERBIT /// Published
  DITOLAK /// Ditolak (catatan_revisi wajib berisi alasan)
  DIARSIPKAN /// Archived — disembunyikan tanpa dihapus (SEO historis)
}

/// Visibilitas nama penulis per artikel (blueprint 6.2).
enum VisibilitasPenulis {
  ASLI /// Tampil & tertaut ke /profil/[username]
  SAMARAN /// Nama tampilan kustom, TIDAK tertaut ke profil
  REDAKSI /// Byline generik "Redaksi info Marhaen"
}

/// Status akun kader (blueprint 7.1).
enum StatusAkun {
  PENDING
  AKTIF
  SUSPEND
}

/// Status moderasi komentar publik (blueprint 7.5 & 8.3).
enum StatusKomentar {
  TAMPIL
  DISEMBUNYIKAN
}

/// Status kirim pesan langsung 1-on-1 (blueprint 8.5): read receipt.
enum StatusPesan {
  TERKIRIM /// baru dikirim, belum dibaca lawan
  DIBACA /// lawan sudah membuka riwayat
}

/// Jenis aktivitas kader yang menghasilkan poin (blueprint 8.4).
/// Nilai poin: ARTIKEL_TERBIT=10, KOMENTAR_TAMPIL=2, AKTIF_HARIAN=1.
enum JenisAktivitas {
  ARTIKEL_TERBIT /// artikel ASLI (bukan samaran/redaksi) yang terbit
  KOMENTAR_TAMPIL /// komentar kader berstatus TAMPIL
  AKTIF_HARIAN /// kehadiran/aktivitas harian kader (maks 1/hari)
}

/// Kategori peringkat mingguan (blueprint 7.7).
enum KategoriPeringkat {
  POIN_UMUM /// total poin gabungan minggu berjalan
  PENULIS_TERAJIN /// jumlah artikel ASLI terbit minggu ini
  AKTIF_DISKUSI /// jumlah komentar TAMPIL minggu ini
  PEMBACA_TERAKTIF /// disiapkan — butuh tracking baca per-user (sub-fase lanjutan)
  PALING_SHARE /// disiapkan — butuh tracking klik share (sub-fase lanjutan)
}

/// Status tayang slot iklan mandiri (Fase 4.1 · blueprint Fase 4).
enum StatusIklan {
  DRAFT /// disiapkan, belum tayang
  AKTIF /// tayang publik bila dalam rentang tanggal
  DIARSIPKAN /// ditarik dari tayang tanpa dihapus
}

/// Lokasi slot iklan non-intrusif di layout publik (Fase 4.1).
enum LokasiSlotIklan {
  HEADER /// bar tipis di bawah navigasi utama
  SIDEBAR /// kartu samping di halaman artikel/berita
}

/// Status verifikasi donasi pers Marhaen (Fase 4.1 · verifikasi manual v1).
enum StatusDonasi {
  MENUNGGU_VERIFIKASI /// baru masuk, belum diverifikasi admin
  TERVERIFIKASI /// sah, masuk widget transparansi publik
  DITOLAK /// spam/tidak valid, disembunyikan dari publik
}

// ============================================================
// 7.1 USER — kader terverifikasi
// ============================================================

model User {
  id                String   @id @default(cuid())
  namaLengkap       String
  username          String   @unique
  email             String   @unique
  nim               String?  @unique /// NIM kader — identitas login (email untuk recovery); nullable utk akun admin/legacy
  nomorWa           String?  @unique /// terverifikasi OTP (Fase 2)
  passwordHash      String
  fotoProfil        String? /// URL ke object storage (Vercel Blob/Cloudinary)
  bio               String? @db.Text
  daerahAsal        String? /// nama daerah/DPC asal
  cabangKomisariat String? /// cabang/komisariat kader (form pendaftaran publik)
  roleId            String
  role              Role     @relation(fields: [roleId], references: [id])
  statusAkun        StatusAkun @default(AKTIF)
  profilTersembunyi Boolean  @default(false) /// toggle sembunyikan dari cari & DM (6.2)
  totpPendingSecret String?  /// secret tentatif TOTP saat wizard setup (4.2)
  totpSecret        String?  /// secret aktif TOTP (RFC 6238, base32)
  is2FAEnabled      Boolean  @default(false) /// 2FA TOTP aktif
  totpAktivasiAt    DateTime?
  totpUpayaGagal    Int      @default(0) /// limiter brute-force OTP (5x → kunci 15 mnt)
  totpKunciSampai   DateTime?
  recoveryKodes     String[] /// hash bcrypt kode pemulihan (tampil 1x saat setup)
  diundangOlehId    String?
  diundangOleh      User?    @relation("RelasiUndangan", fields: [diundangOlehId], references: [id])
  undangan          User[]   @relation("RelasiUndangan")
  tokenUndangan     String?  @unique /// invite token untuk /daftar
  tanggalBergabung  DateTime @default(now())
  terakhirAktif     DateTime?

  artikel           Artikel[]  @relation("ArtikelPenulis")
  artikelDisetujui  Artikel[]  @relation("ArtikelDisetujuiOleh")
  roleDibuat        Role[]     @relation("RoleDibuatOleh")
  halamanStatis     HalamanStatis[] @relation("HalamanDiubahOleh")
  tokohDibuat       Tokoh[]    @relation("TokohDibuatOleh")
  auditLogs         AuditLog[]
  komentar          Komentar[]
  keanggotaanPercakapan AnggotaPercakapan[]
  pesanTerkirim     Pesan[] @relation("PesanTerkirim")
  kegiatan          KegiatanKader[] @relation("KegiatanKader")
  streak            StreakKader? @relation("StreakKader")
  pencapaian        Pencapaian[] @relation("Pencapaian")
  peringkat         PeringkatMingguan[] @relation("PeringkatMingguan")
  iklanDibuat       Iklan[] @relation("IklanDibuatOleh")
  donasiDiverifikasi Donasi[] @relation("DonasiDiverifikasiOleh")
  undanganDibuat    TokenUndangan[] @relation("UndanganDibuatOleh")
  tokenPemulihan    TokenPemulihan[]
  pemulihanDibuat   TokenPemulihan[] @relation("PemulihanDibuatOleh")

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([roleId])
  @@index([tanggalBergabung])
}

// ============================================================
// 7.2 ROLE & PERMISSION — RBAC tidak hardcoded (Bagian 5)
// ============================================================

model Role {
  id            String  @id @default(cuid())
  nama          String  @unique
  deskripsi     String?
  dibuatOlehId  String?
  dibuatOleh    User?   @relation("RoleDibuatOleh", fields: [dibuatOlehId], references: [id])
  /// Role bawaan (Super Admin, Editor, Kontributor) tidak bisa dihapus —
  /// hanya bisa diduplikasi menjadi role baru (blueprint 5.2).
  isSystemDefault Boolean @default(false)

  permissions  RolePermission[]
  users        User[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  kode        String  @unique /// contoh: "artikel.publish", "role.kelola" (blueprint 5.3)
  deskripsi   String?
  roles       RolePermission[]
}

/// Pivot many-to-many Role ↔ Permission (blueprint 7.2).
model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ============================================================
// 7.4 KATEGORI & TAG
// ============================================================

model Kategori {
  id          String   @id @default(cuid())
  nama        String
  slug        String   @unique
  deskripsi   String?  @db.Text
  /// Kategori tetap "Marhaenisme" ditandai agar selalu tampil di atas.
  isTetap     Boolean  @default(false)
  artikel     Artikel[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id      String  @id @default(cuid())
  nama    String
  slug    String  @unique
  artikel ArtikelTag[]
}

/// Pivot many-to-many Artikel ↔ Tag (blueprint 7.3: tag[]).
model ArtikelTag {
  artikelId String
  tagId     String
  artikel   Artikel @relation(fields: [artikelId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([artikelId, tagId])
}

// ============================================================
// 7.3 ARTIKEL — mesin redaksi
// ============================================================

model Artikel {
  id                        String            @id @default(cuid())
  judul                     String
  slug                      String            @unique
  konten                    String            @db.Text /// rich text/HTML hasil editor
  ringkasan                 String?           @db.Text
  gambarUtama               String?           @db.Text /// URL object storage
  kategoriId                String
  kategori                  Kategori          @relation(fields: [kategoriId], references: [id])
  tags                      ArtikelTag[]
  komentar                  Komentar[]
  penulisId                 String
  penulis                   User              @relation("ArtikelPenulis", fields: [penulisId], references: [id])
  status                    StatusArtikel     @default(DRAFT)
  visibilitasPenulis        VisibilitasPenulis @default(ASLI)
  /// Dipakai bila visibilitasPenulis = SAMARAN (blueprint 6.2).
  namaTampilanKustom        String?
  /// Auto-true bila samaran; artikel ini dikecualikan dari gamifikasi (8.4).
  dikecualikanDariLeaderboard Boolean           @default(false)
  /// Artikel pinned (contoh: rubrik Marhaenisme tetap di atas).
  disematkan                Boolean           @default(false)
  disetujuiOlehId           String?
  disetujuiOleh             User?             @relation("ArtikelDisetujuiOleh", fields: [disetujuiOlehId], references: [id])
  /// Wajib diisi admin saat DIMINTA_REVISI / DITOLAK (blueprint 6.1).
  catatanRevisi             String?           @db.Text
  jumlahDilihat             Int               @default(0)
  jumlahDibagikan           Int               @default(0)
  jumlahKomentar            Int               @default(0)
  tanggalDiajukan           DateTime?
  tanggalTerbit             DateTime?
  tanggalDijadwalkan        DateTime?

  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@index([kategoriId])
  @@index([status])
  @@index([penulisId])
  @@index([tanggalTerbit])
  @@index([disematkan])
}

// ============================================================
// 7.5 KOMENTAR — diskusi publik artikel (Fase 2 · blueprint 8.3)
// ============================================================

model Komentar {
  id            String         @id @default(cuid())
  artikelId     String
  artikel       Artikel        @relation(fields: [artikelId], references: [id], onDelete: Cascade)
  /// Diisi bila komentator adalah kader/login; null = pengunjung.
  penulisId     String?
  penulis       User?          @relation(fields: [penulisId], references: [id], onDelete: SetNull)
  /// Nama pengunjung (wajib bila penulisId null).
  namaTamu      String?
  isi           String         @db.Text
  status        StatusKomentar @default(TAMPIL)
  /// Berapa kali pengguna melaporkan komentar ini (blueprint 8.3).
  jumlahLaporan Int            @default(0)
  /// "recaptcha_v3" — metode verifikasi anti-bot saat pengiriman.
  verifikasiVia String?
  tanggal       DateTime       @default(now())

  @@index([artikelId])
  @@index([status])
  @@index([jumlahLaporan])
  @@index([tanggal])
}

// ============================================================
// 7.6 PESAN LANGSUNG — DM 1-on-1 antar kader (Fase 3 · blueprint 8.5)
// ============================================================

/// Ruang obrolan 1-on-1 antar dua kader.
model Percakapan {
  id              String               @id @default(cuid())
  /// Penanda aktivitas terakhir — sort daftar room tanpa join MAX().
  pesanTerakhirAt DateTime?
  anggota         AnggotaPercakapan[]
  pesan           Pesan[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([pesanTerakhirAt])
  @@index([updatedAt])
}

/// Keanggotaan room — tepat 2 baris per percakapan 1-on-1.
model AnggotaPercakapan {
  percakapanId    String
  percakapan      Percakapan @relation(fields: [percakapanId], references: [id], onDelete: Cascade)
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Cursor badge unread + read-receipt per pihak.
  terakhirDibacaAt DateTime?
  tanggalBergabung DateTime  @default(now())

  /// Kunci gabungan mencegah duplikat + jadi kunci dedup 1-on-1.
  @@id([percakapanId, userId])
  @@index([userId])
  @@index([percakapanId])
}

model Pesan {
  id           String      @id @default(cuid())
  percakapanId String
  percakapan   Percakapan  @relation(fields: [percakapanId], references: [id], onDelete: Cascade)
  pengirimId   String
  pengirim     User        @relation("PesanTerkirim", fields: [pengirimId], references: [id], onDelete: Cascade)
  isi          String      @db.Text /// divalidasi 1–2000 karakter di API
  status       StatusPesan @default(TERKIRIM)
  tanggal      DateTime    @default(now())

  @@index([percakapanId, tanggal])
  @@index([pengirimId])
}

// ============================================================
// 7.7 GAMIFIKASI — ledger poin, streak, badge & snapshot (Fase 3.2 · blueprint 8.4)
// Reset mingguan dihitung lewat jendela tanggal (Senin 00:00 WIB) —
// tanpa cron; badge tersimpan permanen sebagai trophy case.
// ============================================================

model KegiatanKader {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation("KegiatanKader", fields: [userId], references: [id], onDelete: Cascade)
  jenis       JenisAktivitas
  poin        Int
  /// Referensi sumber poin (id artikel/komentar) — untuk retraksi moderasi.
  detail      String?
  /// Tanggal hari (UTC, @db.Date) — untuk dedup AKTIF_HARIAN 1x/hari.
  tanggalHari DateTime       @db.Date
  tanggal     DateTime       @default(now())

  @@unique([userId, jenis, tanggalHari])
  @@index([userId, tanggal])
  @@index([jenis, tanggal])
}

model StreakKader {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation("StreakKader", fields: [userId], references: [id], onDelete: Cascade)
  jumlahHariBeruntun Int      @default(0)
  /// Hari terakhir tercatat aktif (UTC date).
  hariTerakhirAktif  DateTime @db.Date
  updatedAt          DateTime @updatedAt
}

model Pencapaian {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation("Pencapaian", fields: [userId], references: [id], onDelete: Cascade)
  /// Contoh: "ARTIKEL_FIRST" | "ARTIKEL_10" | "KOMENTAR_10" | "KOMENTAR_50"
  /// | "STREAK_3" | "STREAK_7" | "STREAK_30" | "TOP_3_MINGGU".
  jenisBadge        String
  /// Periode perolehan: "SEMUA" untuk lifetime, "2026-W37" untuk mingguan.
  periode           String
  tanggalDiperoleh  DateTime @default(now())

  @@unique([userId, jenisBadge, periode])
  @@index([userId])
}

model PeringkatMingguan {
  id                 String            @id @default(cuid())
  mingguMulai        DateTime
  mingguSelesai      DateTime
  kategori           KategoriPeringkat
  userId             String
  user               User              @relation("PeringkatMingguan", fields: [userId], references: [id], onDelete: Cascade)
  skor               Int
  peringkat          Int
  /// Khusus kategori manual (Penulis Terbaik) — FK admin pemilih (sub-fase lanjutan).
  dipilihManualOlehId String?
  createdAt          DateTime          @default(now())

  @@unique([mingguMulai, kategori, userId])
  @@index([mingguMulai, kategori, peringkat])
}

// ============================================================
// 7.9 HALAMAN STATIS — konten no-code, editable admin (Bagian 12)
// ============================================================

model HalamanStatis {
  id                String   @id @default(cuid())
  slug              String   @unique /// "tentang", "redaksi", "pedoman-media-siber", dll
  judul             String
  konten            String   @db.Text /// rich text, editable via /admin/halaman
  terakhirDiubahOlehId String?
  terakhirDiubahOleh   User?  @relation("HalamanDiubahOleh", fields: [terakhirDiubahOlehId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================================
// 7.10 TOKOH — profil tokoh Marhaenis & alumni kader (Fase 3)
// ============================================================

model Tokoh {
  id           String   @id @default(cuid())
  nama         String
  slug         String   @unique
  julukan      String?  /// contoh: "Bung Karno", "Bapak Marhaenisme"
  gambar       String?  /// URL foto (object storage / Supabase Storage)
  biografi     String   @db.Text
  kutipan      String?  @db.Text /// kutipan singkat untuk kartu tokoh
  lahir        Int?     /// tahun lahir
  wafat        Int?     /// tahun wafat; null = masih hidup
  status       String   @default("AKTIF") /// "AKTIF" | "ARSIP"
  urutan       Int      @default(0) /// urutan tampil; 0 = setelah nama
  dibuatOlehId String?
  dibuatOleh   User?    @relation("TokohDibuatOleh", fields: [dibuatOlehId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([urutan])
}

// ============================================================
// 7.11 IKLAN MANDIRI & DONASI PERS MARHAEN (Fase 4.1 · blueprint Fase 4)
// Banner non-intrusif di 2 slot (HEADER/SIDEBAR) + donasi publik
// dengan verifikasi manual admin (MENUNGGU → TERVERIFIKASI/DITOLAK).
// ============================================================

model Iklan {
  id             String         @id @default(cuid())
  nama           String
  gambarUrl      String /// banner (upload /api/media atau URL manual)
  tautanUrl      String /// tujuan klik — divalidasi http(s) di API
  lokasiSlot     LokasiSlotIklan
  urutan         Int            @default(0) /// urutan tampil dalam slot
  tanggalMulai   DateTime?
  tanggalSelesai DateTime? /// AKTIF di luar rentang tidak dirender
  status         StatusIklan    @default(DRAFT)
  jumlahKlik     Int            @default(0)
  dibuatOlehId   String?
  dibuatOleh     User?          @relation("IklanDibuatOleh", fields: [dibuatOlehId], references: [id])

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, lokasiSlot])
}

model Donasi {
  id               String       @id @default(cuid())
  namaDonatur      String /// 2–80 karakter
  nominal          Int /// Rupiah, min 1000
  pesan            String?      @db.Text /// maks 500 karakter
  status           StatusDonasi @default(MENUNGGU_VERIFIKASI)
  verifikasiOlehId String?
  verifikasiOleh   User?        @relation("DonasiDiverifikasiOleh", fields: [verifikasiOlehId], references: [id])
  verifikasiAt     DateTime?

  createdAt        DateTime     @default(now())

  @@index([status, createdAt])
}

// ============================================================
// 7.8 AUDIT LOG — jejak semua perubahan (Bagian 9.2)
// ============================================================

model AuditLog {
  id            String   @id @default(cuid())
  aktorId       String?
  aktor         User?    @relation(fields: [aktorId], references: [id])
  aksi          String   /// contoh: "artikel.update", "role.create"
  entitasTipe   String   /// "Artikel" | "User" | "Role" | "HalamanStatis" | ...
  entitasId     String
  /// Snapshot JSON sebelum/sesudah — transparansi internal & forensik.
  dataSebelum   Json?
  dataSesudah   Json?
  alamatIp      String?

  tanggal       DateTime @default(now())

  @@index([entitasTipe, entitasId])
  @@index([aktorId])
  @@index([tanggal])
}

/// Tautan undangan global (generator admin, sekali pakai) — tidak terikat
/// ke kartu kader tertentu; dibuat lewat panel atas /admin/pengguna.
model TokenUndangan {
  id           String    @id @default(cuid())
  token        String    @unique
  dibuatOlehId String?
  dibuatOleh   User?     @relation("UndanganDibuatOleh", fields: [dibuatOlehId], references: [id], onDelete: SetNull)
  dipakaiAt    DateTime? /// sekali pakai — di-set saat /api/auth/register consume
  createdAt    DateTime  @default(now())

  @@index([dipakaiAt])
  @@index([dibuatOlehId])
}

// ============================================================
// 7.12 TOKEN PEMULIHAN SANDI (Fase 4.3) — lupa sandi sekali pakai.
//  Alur: minta di /lupa-password (atau link admin di /admin/pengguna)
//  → token 32-hex exp 30 mnt (admin: 24 jam) → /pulihkan-sandi?token=
//  → consume sekali pakai + audit. Email via Resend REST bila RESEND_API_KEY
//  dikonfigurasi; tanpa key → link hanya tampil ke admin / log server.
// ============================================================

model TokenPemulihan {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String    @unique /// 64 karakter hex (randomBytes 32)
  dipakaiAt     DateTime? /// sekali pakai
  kedaluwarsaAt DateTime
  dibuatOlehId  String?   /// di-set bila dibuat manual oleh admin (pintu darurat)
  dibuatOleh    User?     @relation("PemulihanDibuatOleh", fields: [dibuatOlehId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([kedaluwarsaAt])
}
