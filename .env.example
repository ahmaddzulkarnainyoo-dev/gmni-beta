# ============================================================
# info Marhaen — Contoh konfigurasi lingkungan (copy → .env)
# JANGAN commit .env — file ini hanya templat.
# ============================================================

# --- DATABASE (PostgreSQL via Supabase) ---
# Isi dengan connection string dari Supabase Dashboard:
#   Settings → Database → Connection string
# Session pooler (port 5432) untuk prisma db push / seed / next dev.
DATABASE_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Produksi serverless (Vercel): gunakan Transaction pooler port 6543:
#   DATABASE_URL="postgresql://postgres.<ref>:<PW>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# --- SEED: kredensial Super Admin pertama (dibaca saat `prisma db seed`) ---
SEED_ADMIN_NAMA="Super Admin GMNI"
SEED_ADMIN_USERNAME="superadmin"
SEED_ADMIN_EMAIL="admin@infomarhaen.or.id"
SEED_ADMIN_PASSWORD="GantiSandiSuperAdmin123!"

# --- AUTH (Auth.js / NextAuth v4) ---
AUTH_SECRET="info-marhaen-secret-key-gmni-2026"
NEXTAUTH_SECRET="info-marhaen-secret-key-gmni-2026"
# NEXTAUTH_URL="http://localhost:3000"

# --- SUPABASE (storage/media) ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# Bucket `bukti-kas` harus dibuat privat dari Supabase Dashboard sebelum upload kas.
# Service role hanya untuk server; jangan gunakan prefix NEXT_PUBLIC_ dan jangan bocorkan.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
SUPABASE_KAS_BUCKET="bukti-kas"
SUPABASE_STORAGE_BUCKET="artikel"
SUPABASE_AVATAR_BUCKET="avatars"

# --- GOOGLE reCAPTCHA v3 (anti-bot kolom komentar, blueprint 8.3) ---
# Ambil dari https://www.google.com/recaptcha/admin — jenis "reCAPTCHA v3".
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
